{
  "name": "tremendous-asteroid",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "production-dev": "PRODUCTION=true astro dev",
    "production-build": "PRODUCTION=true astro build",
    "production-preview": "PRODUCTION=true astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "biome": "biome check",
    "biome:apply": "biome check --write",
    "biome:ci": "biome ci",
    "preCommit": "pnpm run biome:apply",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest --run",
    "test:unit:ui": "vitest --ui",
    "test:storybook": "vitest --project=storybook --run",
    "test": "pnpm run test:unit && pnpm run test:storybook && pnpm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/vercel": "9.0.4",
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@fontsource/noto-serif-jp": "5.2.5",
    "@mui/icons-material": "6.0.2",
    "@mui/joy": "5.0.0-beta.48",
    "@mui/material": "6.0.2",
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "@vercel/speed-insights": "1.0.12",
    "astro": "5.18.0",
    "html-react-parser": "5.2.6",
    "isomorphic-dompurify": "3.0.0",
    "microcms-js-sdk": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "typescript": "5.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@biomejs/biome": "1.9.2",
    "@chromatic-com/storybook": "4.1.3",
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "9.1.19",
    "@storybook/addon-links": "9.1.19",
    "@storybook/addon-onboarding": "9.1.19",
    "@storybook/addon-vitest": "9.1.19",
    "@storybook/react-vite": "9.1.19",
    "@vitest/browser": "^3.2.3",
    "@vitest/coverage-v8": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "jsdom": "^26.1.0",
    "playwright": "1.58.2",
    "storybook": "9.1.19",
    "vitest": "^3.2.3"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "overrides": {
      "storybook": "$storybook",
      "lodash": ">=4.17.23"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@vercel/speed-insights",
      "esbuild",
      "sharp"
    ]
  }
}
